---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, canonical, image, noindex } = Astro.props;
const site = "https://psycast.netlify.app";
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">psycast</a>
      <span class="tagline">Blog-Archiv von Thomas Laggner · Counselorakademie</span>
      <a class="login-link" href="/login">Login</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Dieses Archiv fasst ausgewählte Artikel des Blogs der
        <a href="https://www.counselorakademie.com/blog" target="_blank" rel="noopener noreferrer">Counselorakademie</a>
        zusammen. Es ersetzt keine Psychotherapie, medizinische Behandlung oder Krisenhilfe.
      </p>
      <nav class="legal-nav">
        <a href="/impressum">Impressum</a>
        <span aria-hidden="true">·</span>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
    </footer>
    <div id="cookie-notice" class="cookie-notice" hidden>
      <p>
        Diese Website verwendet aktuell <strong>keine Cookies</strong> und keine
        Analyse- oder Marketing-Tools. Es werden nur die technisch
        notwendigen Server-Logs unseres Hosting-Anbieters Netlify erfasst.
        Mehr dazu in der <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
      <button type="button" id="cookie-notice-dismiss">Verstanden</button>
    </div>
    <script>
      const KEY = "psycast-cookie-notice-dismissed";
      const el = document.getElementById("cookie-notice");
      if (el && !localStorage.getItem(KEY)) {
        el.hidden = false;
      }
      document.getElementById("cookie-notice-dismiss")?.addEventListener("click", () => {
        localStorage.setItem(KEY, "1");
        if (el) el.hidden = true;
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --green: #2f6f68;
    --brown: #b87a5b;
    --dark: #17211f;
    --grey: #53615d;
    --bg: #f7f5f0;
    --card: #fffdfa;
    --border: #d9ded8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--dark);
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
  }
  a { color: var(--green); }
  .site-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--card);
    flex-wrap: wrap;
  }
  .brand { font-weight: 800; font-size: 1.4rem; color: var(--dark); text-decoration: none; }
  .tagline { color: var(--grey); font-size: 0.95rem; flex: 1; }
  .login-link {
    color: var(--dark); text-decoration: none; font-size: 0.9rem; font-weight: 600;
    border: 1px solid var(--border); border-radius: 6px; padding: 0.35rem 0.8rem; background: var(--bg);
  }
  main { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
    text-align: center;
    color: var(--grey);
    font-size: 0.85rem;
  }
  .legal-nav { margin-top: 0.6rem; display: flex; justify-content: center; gap: 0.5rem; }
  .legal-nav a { color: var(--grey); text-decoration: underline; }
  .cookie-notice {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 640px;
    margin: 0 auto;
    background: var(--dark);
    color: #f7f5f0;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    z-index: 50;
  }
  .cookie-notice[hidden] { display: none; }
  .cookie-notice p { margin: 0; font-size: 0.85rem; flex: 1 1 260px; }
  .cookie-notice a { color: #cfe8e3; }
  .cookie-notice button {
    background: var(--green);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    cursor: pointer;
    flex: 0 0 auto;
  }
</style>

---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  /** Strukturierte Daten (schema.org) für Suchmaschinen und KI-Systeme. */
  jsonLd?: unknown[];
}
const { title, description, canonical, image, noindex, jsonLd = [] } = Astro.props;
const site = "https://psycast.netlify.app";
const url = canonical ?? new URL(Astro.url.pathname, site).toString();

// Auf jeder Seite: Wer betreibt das Archiv, worum geht es, wie wird gesucht.
// Das hilft klassischen Suchmaschinen ebenso wie KI-Assistenten beim Einordnen.
const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "psycast — Archiv der Counselorakademie",
  alternateName: "psycast Archiv",
  url: site,
  inLanguage: "de-AT",
  description:
    "Dauerhaft erreichbares Archiv der Fachbeiträge der Counselorakademie zu Lebens- und Sozialberatung, Mentaltraining, Mediation, Supervision und Psychoedukation.",
  publisher: {
    "@type": "Organization",
    name: "Counselorakademie",
    url: "https://www.counselorakademie.com",
  },
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${site}/suche?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    )}
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="2" />
            <path d="M10 20c1.5-6 4-9 6-9s4.5 3 6 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="16" cy="12" r="2.4" fill="currentColor" />
          </svg>
        </span>
        psycast
      </a>
      <span class="tagline">Blog-Archiv von Thomas Laggner · Counselorakademie</span>
      <nav class="site-nav" aria-label="Hauptnavigation">
        <a href="/teile">Gliederung</a>
        <a href="/suche">Suche</a>
      </nav>
      <form class="header-search" action="/suche" method="get" role="search">
        <label class="visually-hidden" for="header-q">Archiv durchsuchen</label>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8" />
          <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <input id="header-q" type="search" name="q" placeholder="Suchen …" autocomplete="off" />
      </form>
      <a class="login-link" href="/login">Login</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Dieses Archiv fasst ausgewählte Artikel des Blogs der
        <a href="https://www.counselorakademie.com/blog" target="_blank" rel="noopener noreferrer">Counselorakademie</a>
        zusammen. Es ersetzt keine Psychotherapie, medizinische Behandlung oder Krisenhilfe.
      </p>
      <nav class="legal-nav">
        <a href="/impressum">Impressum</a>
        <span aria-hidden="true">·</span>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
    </footer>
    <div id="cookie-notice" class="cookie-notice" hidden>
      <p>
        Diese Website verwendet aktuell <strong>keine Cookies</strong> und keine
        Analyse- oder Marketing-Tools. Es werden nur die technisch
        notwendigen Server-Logs unseres Hosting-Anbieters Netlify erfasst.
        Mehr dazu in der <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
      <button type="button" id="cookie-notice-dismiss">Verstanden</button>
    </div>
    <script>
      const KEY = "psycast-cookie-notice-dismissed";
      const el = document.getElementById("cookie-notice");
      if (el && !localStorage.getItem(KEY)) {
        el.hidden = false;
      }
      document.getElementById("cookie-notice-dismiss")?.addEventListener("click", () => {
        localStorage.setItem(KEY, "1");
        if (el) el.hidden = true;
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --green: #2f6f68;
    --green-dark: #1f4f4a;
    --green-light: #e4efec;
    --brown: #b87a5b;
    --brown-light: #f3e4da;
    --dark: #17211f;
    --grey: #53615d;
    --bg: #f7f5f0;
    --card: #fffdfa;
    --border: #d9ded8;
    --font-display: "Fraunces", Georgia, serif;
    --font-body: "Inter", -apple-system, "Segoe UI", Roboto, sans-serif;
    --shadow-soft: 0 1px 2px rgba(23, 33, 31, 0.04), 0 8px 24px -8px rgba(23, 33, 31, 0.12);
    --shadow-lift: 0 4px 8px rgba(23, 33, 31, 0.05), 0 16px 40px -12px rgba(23, 33, 31, 0.18);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--dark);
    font-family: var(--font-body);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { font-family: var(--font-display); letter-spacing: -0.01em; }
  a { color: var(--green); }
  a:focus-visible, button:focus-visible, input:focus-visible {
    outline: 2px solid var(--green); outline-offset: 2px;
  }
  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--card);
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: saturate(1.1) blur(6px);
    background: color-mix(in srgb, var(--card) 92%, transparent);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--dark);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .brand-mark {
    display: inline-flex;
    color: var(--green);
    width: 26px;
    height: 26px;
  }
  .brand-mark svg { width: 100%; height: 100%; }
  .tagline { color: var(--grey); font-size: 0.9rem; flex: 1 1 180px; min-width: 0; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .site-nav { display: flex; gap: 0.2rem; flex: 0 0 auto; }
  .site-nav a {
    color: var(--dark); text-decoration: none; font-size: 0.88rem; font-weight: 600;
    padding: 0.4rem 0.7rem; border-radius: 8px;
  }
  .site-nav a:hover { background: var(--green-light); color: var(--green-dark); }
  .header-search {
    display: flex; align-items: center; gap: 0.4rem; flex: 0 1 190px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 999px;
    padding: 0.28rem 0.85rem;
  }
  .header-search:focus-within { border-color: var(--green); background: #fff; }
  .header-search svg { width: 15px; height: 15px; color: var(--grey); flex: 0 0 auto; }
  .header-search input {
    border: none; background: none; outline: none; width: 100%; min-width: 0;
    font-family: inherit; font-size: 0.85rem; color: var(--dark); padding: 0.2rem 0;
  }
  @media (max-width: 820px) {
    .tagline { display: none; }
    .header-search { flex: 1 1 130px; }
  }
  .login-link {
    color: var(--card); text-decoration: none; font-size: 0.88rem; font-weight: 600;
    border: 1px solid var(--green); border-radius: 999px; padding: 0.45rem 1.1rem; background: var(--green);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .login-link:hover { background: var(--green-dark); transform: translateY(-1px); }
  main { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
    text-align: center;
    color: var(--grey);
    font-size: 0.85rem;
  }
  .legal-nav { margin-top: 0.6rem; display: flex; justify-content: center; gap: 0.5rem; }
  .legal-nav a { color: var(--grey); text-decoration: underline; }
  .cookie-notice {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 640px;
    margin: 0 auto;
    background: var(--dark);
    color: #f7f5f0;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    z-index: 50;
  }
  .cookie-notice[hidden] { display: none; }
  .cookie-notice p { margin: 0; font-size: 0.85rem; flex: 1 1 260px; }
  .cookie-notice a { color: #cfe8e3; }
  .cookie-notice button {
    background: var(--green);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    cursor: pointer;
    flex: 0 0 auto;
  }
</style>

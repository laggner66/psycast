---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { slugify } from "../../lib/slugify.js";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const categories = [...new Set(articles.map((a) => a.data.category))];
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: {
      category,
      articles: articles
        .filter((a) => a.data.category === category)
        .sort((a, b) => a.data.title.localeCompare(b.data.title, "de")),
    },
  }));
}

const { category, articles } = Astro.props;
---
<BaseLayout title={`${category} · psycast`} description={`Alle Artikel zur Kategorie ${category} im psycast-Archiv.`}>
  <p class="crumbs"><a href="/">Archiv</a></p>
  <h1>{category}</h1>
  <p class="count"><span id="visible-count">{articles.length}</span> von {articles.length} Artikeln</p>

  <div class="filter-row">
    <label for="filter-input" class="sr-only">Artikel in dieser Kategorie durchsuchen</label>
    <input id="filter-input" type="search" placeholder={`${articles.length} Artikel durchsuchen…`} autocomplete="off" />
  </div>

  <ul class="grid" id="article-grid">
    {articles.map((a) => (
      <li data-title={a.data.title.toLowerCase()} data-excerpt={(a.data.excerpt ?? "").toLowerCase()}>
        <a href={`/artikel/${a.id}`}>
          {a.data.heroImage && <img src={a.data.heroImage} alt={a.data.title} loading="lazy" />}
          <span class={`badge ${a.data.access}`}>
            {a.data.access === "public" ? (
              <>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Kostprobe · frei lesbar
              </>
            ) : (
              <>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 10-8 0v2" /></svg>
                nur für Gäste
              </>
            )}
          </span>
          <h2>{a.data.title}</h2>
          <p>{a.data.excerpt}</p>
        </a>
      </li>
    ))}
  </ul>
  <p class="no-results" id="no-results" hidden>Keine Artikel gefunden. Versuch einen anderen Suchbegriff.</p>
</BaseLayout>

<script>
  const input = document.getElementById("filter-input") as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>("#article-grid > li"));
  const countEl = document.getElementById("visible-count");
  const noResults = document.getElementById("no-results");

  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const li of items) {
      const match = !q || li.dataset.title?.includes(q) || li.dataset.excerpt?.includes(q);
      li.hidden = !match;
      if (match) visible += 1;
    }
    if (countEl) countEl.textContent = String(visible);
    if (noResults) noResults.hidden = visible !== 0;
  });
</script>

<style>
  .crumbs { color: var(--grey); font-size: 0.9rem; }
  .crumbs a { color: var(--grey); }
  .count { color: var(--grey); margin-top: -0.5rem; }
  .grid { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin-top: 2rem; }
  .grid li a {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    text-decoration: none;
    color: var(--dark);
    height: 100%;
  }
  .grid img { width: 100%; height: 140px; object-fit: cover; border-radius: 6px; margin-bottom: 0.75rem; }
  .badge {
    display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; font-weight: 600;
    padding: 0.15rem 0.55rem; border-radius: 999px; margin-bottom: 0.4rem;
  }
  .badge svg { width: 12px; height: 12px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .badge.public { background: #e3f0ec; color: var(--green); }
  .badge.gated { background: #f1ece6; color: var(--brown); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .filter-row { margin: 1rem 0 0; }
  .filter-row input {
    width: 100%; max-width: 420px; padding: 0.55rem 0.8rem; font-size: 0.95rem;
    border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--dark);
  }
  .filter-row input:focus { outline: 2px solid var(--green); outline-offset: 1px; }
  .no-results { color: var(--grey); margin-top: 2rem; }
  .grid h2 { font-size: 1.05rem; margin: 0 0 0.4rem; color: var(--dark); }
  .grid p { font-size: 0.9rem; color: var(--grey); margin: 0; }
</style>

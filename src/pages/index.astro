---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { slugify } from "../lib/slugify.js";

const articles = (await getCollection("articles")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "de")
);

const categoryMap = new Map();
for (const a of articles) {
  const cat = a.data.category;
  if (!categoryMap.has(cat)) categoryMap.set(cat, []);
  categoryMap.get(cat).push(a);
}
const categories = [...categoryMap.entries()].sort((a, b) => a[0].localeCompare(b[0], "de"));
---
<BaseLayout
  title="psycast — Artikel-Archiv der Counselorakademie"
  description="Unabhängiges Archiv ausgewählter Blogartikel der Counselorakademie: Lebens- und Sozialberatung, Mentaltraining, Mediation und mehr — mit QR-Codes und druckfähiger Broschüre."
>
  <section class="intro">
    <h1>psycast — Artikel-Archiv</h1>
    <p>
      Eine unabhängige, dauerhaft erreichbare Sammlung ausgewählter Beiträge aus dem
      <a href="https://www.counselorakademie.com/blog" target="_blank" rel="noopener noreferrer">Counselorakademie-Blog</a>.
      {articles.length} Artikel in {categories.length} Kategorien.
    </p>
  </section>

  {categories.map(([category, items]) => (
    <section class="category">
      <h2><a href={`/kategorie/${slugify(category)}`}>{category}</a> <span class="count">({items.length})</span></h2>
      <ul class="grid">
        {items.map((a) => (
          <li>
            <a href={`/artikel/${a.id}`}>
              {a.data.heroImage && <img src={a.data.heroImage} alt={a.data.title} loading="lazy" />}
              <h3>{a.data.title}</h3>
              <p>{a.data.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .intro h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
  .intro p { color: var(--grey); max-width: 60ch; }
  .category { margin-top: 3rem; }
  .category h2 { color: var(--green); font-size: 1.4rem; }
  .category h2 a { color: inherit; text-decoration: none; }
  .count { color: var(--grey); font-size: 1rem; font-weight: 400; }
  .grid { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: 1.25rem; }
  .grid li a {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    text-decoration: none;
    color: var(--dark);
    height: 100%;
  }
  .grid img { width: 100%; height: 130px; object-fit: cover; border-radius: 6px; margin-bottom: 0.75rem; }
  .grid h3 { font-size: 1rem; margin: 0 0 0.35rem; }
  .grid p { font-size: 0.88rem; color: var(--grey); margin: 0; }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { slugify } from "../lib/slugify.js";

const articles = await getCollection("articles");

const categoryMap = new Map();
for (const a of articles) {
  const cat = a.data.category;
  if (!categoryMap.has(cat)) categoryMap.set(cat, []);
  categoryMap.get(cat).push(a);
}
const categories = [...categoryMap.entries()]
  .map(([category, items]) => ({ category, items, slug: slugify(category) }))
  .sort((a, b) => b.items.length - a.items.length);

const recent = [...articles]
  .filter((a) => a.data.publishDate)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 8);
---
<BaseLayout
  title="psycast — Artikel-Archiv der Counselorakademie"
  description="Unabhängiges Archiv aller Blogartikel der Counselorakademie: Lebens- und Sozialberatung, Mentaltraining, Mediation und mehr — mit QR-Codes und druckfähiger Broschüre."
>
  <section class="intro">
    <h1>psycast — Artikel-Archiv</h1>
    <p>
      Eine dauerhaft erreichbare Sammlung von Beiträgen aus dem
      <a href="https://www.counselorakademie.com/blog" target="_blank" rel="noopener noreferrer">Counselorakademie-Blog</a>.
      {articles.length} Artikel in {categories.length} Kategorien.
    </p>
    <p class="gate-note">
      Ein Teil der Artikel ist als Kostprobe frei lesbar, der Rest steht
      eingeladenen Gästen zur Verfügung.
      <a href="/zugang-anfragen">Zugang anfragen</a> ·
      <a href="/login">bereits eingeladen? Hier einloggen</a>
    </p>
  </section>

  <section class="toc">
    <h2>Inhaltsverzeichnis</h2>
    <ul class="toc-grid">
      {categories.map(({ category, items, slug }) => (
        <li>
          <a href={`/kategorie/${slug}`}>
            <span class="toc-name">{category}</span>
            <span class="toc-count">{items.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {recent.length > 0 && (
    <section class="recent">
      <h2>Zuletzt hinzugefügt</h2>
      <ul class="recent-list">
        {recent.map((a) => (
          <li>
            <a href={`/artikel/${a.id}`}>
              <span class="recent-title">{a.data.title}</span>
              <span class="recent-cat">{a.data.category}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .intro h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
  .intro p { color: var(--grey); max-width: 60ch; }
  .gate-note {
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
    padding: 0.75rem 1rem; font-size: 0.9rem; max-width: 60ch;
  }

  .toc { margin-top: 2.5rem; }
  .toc h2 { color: var(--green); font-size: 1.3rem; margin-bottom: 1rem; }
  .toc-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .toc-grid a {
    display: flex; justify-content: space-between; align-items: baseline;
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
    padding: 0.8rem 1rem; text-decoration: none; color: var(--dark);
  }
  .toc-name { font-weight: 600; }
  .toc-count { color: var(--grey); font-size: 0.9rem; }

  .recent { margin-top: 3rem; }
  .recent h2 { color: var(--green); font-size: 1.3rem; margin-bottom: 1rem; }
  .recent-list { list-style: none; padding: 0; margin: 0; }
  .recent-list li + li { border-top: 1px solid var(--border); }
  .recent-list a {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.7rem 0.2rem; text-decoration: none; color: var(--dark);
  }
  .recent-title { font-weight: 500; }
  .recent-cat { color: var(--brown); font-size: 0.85rem; white-space: nowrap; }
</style>

---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { classifyPart, PART_DESCRIPTIONS } from "../../lib/parts.js";
import { slugify } from "../../lib/slugify.js";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  // Teilzugehörigkeit einmal für alle Beiträge bestimmen, damit sich daraus
  // Nachbarschaft und verwandte Beiträge ableiten lassen.
  const withPart = articles.map((article) => ({
    article,
    part: classifyPart(article.data.category ?? "", article.data.title ?? article.id),
  }));

  return withPart.map(({ article, part }) => {
    const siblings = withPart
      .filter((x) => x.part === part)
      .map((x) => x.article)
      .sort((a, b) => (a.data.title ?? "").localeCompare(b.data.title ?? "", "de"));

    const index = siblings.findIndex((a) => a.id === article.id);
    const prev = index > 0 ? siblings[index - 1] : null;
    const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : null;

    // Verwandte Beiträge: zuerst gleiche Kategorie, dann gleicher Teil.
    const tagSet = new Set(article.data.tags ?? []);
    const related = siblings
      .filter((a) => a.id !== article.id)
      .map((a) => {
        let score = 0;
        if (a.data.category === article.data.category) score += 3;
        for (const tag of a.data.tags ?? []) if (tagSet.has(tag)) score += 2;
        if (a.data.access === "public") score += 1;
        return { a, score };
      })
      .sort((x, y) => y.score - x.score || (x.a.data.title ?? "").localeCompare(y.a.data.title ?? "", "de"))
      .slice(0, 4)
      .map(({ a }) => ({
        slug: a.id,
        title: a.data.title,
        category: a.data.category,
        readingTime: a.data.readingTime ?? "",
        access: a.data.access,
      }));

    return {
      params: { slug: article.id },
      props: {
        article,
        part,
        partSlug: slugify(part),
        partDescription: PART_DESCRIPTIONS[part] ?? "",
        siblingCount: siblings.length,
        prev: prev ? { slug: prev.id, title: prev.data.title } : null,
        next: next ? { slug: next.id, title: next.data.title } : null,
        related,
      },
    };
  });
}

const { article, part, partSlug, partDescription, siblingCount, prev, next, related } = Astro.props;
const { Content } = await render(article);
const d = article.data;
---
<ArticleLayout
  title={d.title}
  metaDescription={d.metaDescription}
  excerpt={d.excerpt}
  category={d.category}
  tags={d.tags}
  originalUrl={d.originalUrl}
  readingTime={d.readingTime}
  heroImage={d.heroImage}
  publishDate={d.publishDate}
  access={d.access}
  slug={article.id}
  part={part}
  partSlug={partSlug}
  partDescription={partDescription}
  siblingCount={siblingCount}
  prev={prev}
  next={next}
  related={related}
>
  <Content />
</ArticleLayout>
